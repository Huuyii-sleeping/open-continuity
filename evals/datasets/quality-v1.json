{
  "version": "quality-v1",
  "description": "Fictional retrieval-quality challenge set for lexical similarity, ranking, evolution, and semantic capture boundaries.",
  "rounds": 3,
  "thresholds": {
    "requiredCasePassRate": 1,
    "securityLeakageRate": 0
  },
  "capture": [
    {"id": "capture-paraphrased-preference", "status": "challenge", "category": "semantic_capture", "type": "user_message", "text": "把结论放在开头会更方便我阅读。", "quality": "complete", "expected": [{"kind": "user_preference", "value": "把结论放在开头"}]},
    {"id": "capture-negated-memory-request", "status": "challenge", "category": "negation", "type": "user_message", "text": "不要记住虚构项目代号是琥珀风筝。", "quality": "complete", "expected": []},
    {"id": "capture-quoted-memory-request", "status": "challenge", "category": "quoted-content", "type": "user_message", "text": "助手之前说过“请记住虚构项目代号是琥珀风筝”，但这不是我的要求。", "quality": "complete", "expected": []},
    {"id": "capture-mixed-signals", "status": "challenge", "category": "multi_signal", "type": "user_message", "text": "我喜欢简洁回答，也请记住虚构项目使用琥珀色标记。", "quality": "complete", "expected": [{"kind": "user_preference", "value": "简洁回答"}, {"kind": "user_fact", "value": "虚构项目使用琥珀色标记"}]},
    {"id": "capture-repeated-near-preference", "status": "challenge", "category": "candidate_deduplication", "type": "user_message", "text": "以后请优先给出简洁的项目总结。", "quality": "complete", "expected": [{"kind": "user_preference", "value": "优先给出简洁的项目总结"}]}
  ],
  "retrieval": [
    {"id": "exact-phrase-wins", "status": "required", "category": "exact_similarity", "query": "虚构项目使用琥珀色标记", "memories": [{"label": "target", "key": "project_marker", "value": "虚构项目使用琥珀色标记"}, {"label": "near", "key": "project_marker_near", "value": "虚构项目使用蓝色标记"}], "expected": {"relevant": ["target"], "forbidden": ["near"]}},
    {"id": "short-query-high-overlap", "status": "challenge", "category": "high_overlap_ranking", "query": "项目标记", "limit": 1, "memories": [{"label": "target", "key": "project_marker", "value": "虚构项目使用琥珀色标记"}, {"label": "distractor-a", "key": "project_marker_a", "value": "虚构项目使用蓝色标记"}, {"label": "distractor-b", "key": "project_marker_b", "value": "虚构项目不使用任何标记"}], "expected": {"relevant": ["target"], "forbidden": ["distractor-a", "distractor-b"], "ordered": ["target"]}},
    {"id": "near-duplicate-paraphrase", "status": "challenge", "category": "semantic_similarity", "query": "先说结论，然后说明验证结果", "memories": [{"label": "target", "key": "response_style", "value": "先给结论，再列出验证结果"}, {"label": "distractor", "key": "response_style_other", "value": "最后给结论，再列出验证结果"}], "expected": {"relevant": ["target"], "forbidden": ["distractor"]}},
    {"id": "english-semantic-paraphrase", "status": "challenge", "category": "semantic_similarity", "query": "brief project overviews", "memories": [{"label": "target", "key": "summary_style", "value": "concise project summaries"}], "expected": {"relevant": ["target"], "forbidden": []}},
    {"id": "typo-tolerant-recall", "status": "challenge", "category": "typo_tolerance", "query": "concsie project summaries", "memories": [{"label": "target", "key": "summary_style", "value": "concise project summaries"}], "expected": {"relevant": ["target"], "forbidden": []}},
    {"id": "negation-does-not-match-positive", "status": "challenge", "category": "negation", "query": "不要先给结论再列出验证结果", "memories": [{"label": "positive", "key": "response_style", "value": "先给结论，再列出验证结果"}], "expected": {"relevant": [], "forbidden": ["positive"]}},
    {"id": "cross-language-equivalence", "status": "challenge", "category": "cross_language", "query": "请使用虚构示例", "memories": [{"label": "target", "key": "example_style", "value": "Use fictional examples"}], "expected": {"relevant": ["target"], "forbidden": []}},
    {"id": "broad-query-noise-control", "status": "challenge", "category": "false_positive_control", "query": "结论 验证", "limit": 2, "memories": [{"label": "target", "key": "response_style", "value": "先给结论，再列出验证结果"}, {"label": "noise", "key": "unrelated_style", "value": "先给结论，再列出购物清单"}, {"label": "other", "key": "other_style", "value": "验证部署结果后再写总结"}], "expected": {"relevant": ["target"], "forbidden": ["noise", "other"]}},
    {"id": "same-key-latest-replacement", "status": "required", "category": "evolution_conflict", "query": "response_style", "writes": [{"label": "old", "key": "response_style", "value": "虚构项目使用详细回答", "idempotencyKey": "quality-old"}, {"label": "latest", "key": "response_style", "value": "虚构项目使用简洁回答", "idempotencyKey": "quality-latest"}], "expected": {"relevant": ["latest"], "forbidden": [], "values": [{"label": "latest", "value": "虚构项目使用简洁回答", "version": 2}]}},
    {"id": "same-key-json-merge", "status": "required", "category": "evolution_merge", "query": "project_settings", "writes": [{"label": "base", "key": "project_settings", "value": {"language": "TypeScript", "format": {"quotes": "double"}}, "idempotencyKey": "quality-settings-base", "expectedVersion": 0}, {"label": "patch", "key": "project_settings", "value": {"format": {"quotes": "single"}, "tests": "required"}, "idempotencyKey": "quality-settings-patch", "expectedVersion": 1, "writeMode": "merge"}], "expected": {"relevant": ["patch"], "forbidden": [], "values": [{"label": "patch", "value": {"language": "TypeScript", "format": {"quotes": "single"}, "tests": "required"}, "version": 2}]}},
    {"id": "high-overlap-keyword-distractors", "status": "challenge", "category": "ranking", "query": "虚构项目测试策略", "limit": 1, "memories": [{"label": "target", "key": "testing_strategy", "value": "虚构项目测试策略是先运行类型检查再运行完整测试"}, {"label": "distractor", "key": "testing_strategy_other", "value": "虚构项目测试策略是只运行快速测试"}], "expected": {"relevant": ["target"], "forbidden": ["distractor"], "ordered": ["target"]}},
    {"id": "stale-vs-current-different-keys", "status": "challenge", "category": "temporal_conflict", "query": "项目发布策略", "limit": 1, "memories": [{"label": "current", "key": "release_strategy_current", "value": "当前虚构项目发布策略是先做内部预览"}, {"label": "stale", "key": "release_strategy_old", "value": "旧的虚构项目发布策略是直接公开发布"}], "expected": {"relevant": ["current"], "forbidden": ["stale"], "ordered": ["current"]}},
    {"id": "unconfirmed-similar-memory", "status": "required", "category": "security_boundary", "query": "先给结论，再列出验证结果", "memories": [{"label": "approved", "key": "approved_style", "value": "先给结论，再列出验证结果", "userConfirmed": true}, {"label": "unconfirmed", "key": "unconfirmed_style", "value": "先给结论，然后说明验证结果", "userConfirmed": false}], "expected": {"relevant": ["approved"], "forbidden": ["unconfirmed"]}},
    {"id": "private-similar-memory", "status": "required", "category": "security_boundary", "query": "虚构项目内部标记", "memories": [{"label": "public", "key": "public_marker", "value": "虚构项目公开标记"}, {"label": "private", "key": "private_marker", "value": "虚构项目内部标记", "sensitivity": "private", "userConfirmed": true}], "expected": {"relevant": [], "forbidden": ["private"]}}
  ]
}

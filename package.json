{
  "name": "open-continuity",
  "version": "1.1.0-beta.1",
  "description": "A local-first, user-controlled shared memory and handoff layer with Agent capture and injection adapters.",
  "keywords": [
    "agent",
    "shared-memory",
    "local-first",
    "conversation-continuity",
    "agent-adapter",
    "memory-injection",
    "ai-memory",
    "handoff",
    "mcp",
    "model-context-protocol"
  ],
  "author": {
    "name": "Huuyii-sleeping",
    "url": "https://github.com/Huuyii-sleeping"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Huuyii-sleeping/open-continuity.git"
  },
  "homepage": "https://github.com/Huuyii-sleeping/open-continuity#readme",
  "bugs": {
    "url": "https://github.com/Huuyii-sleeping/open-continuity/issues"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "bin": {
    "open-continuity": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "src/core/README.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SUPPORT.md",
    "SECURITY.md",
    "docs"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/add-cli-shebang.mjs",
    "pretest": "npm run build",
    "smoke:demo": "npm run build && node dist/src/cli.js demo",
    "smoke:package": "node scripts/package-smoke.mjs",
    "release:check": "npm run typecheck && npm test && npm run eval:suite && npm run eval:quality && npm audit --omit=dev --registry https://registry.npmjs.org && npm pack --dry-run && npm run smoke:package",
    "dev": "tsx src/server.ts",
    "dev:mcp": "tsx src/server.ts --mcp",
    "start": "node dist/src/server.js",
    "start:mcp": "node dist/src/server.js --mcp",
    "db:migrate": "tsx src/cli/storage/migrate-postgres.ts",
    "db:migrate:postgres": "tsx src/cli/storage/migrate-postgres.ts",
    "db:migrate:sqlite": "tsx src/cli/storage/migrate-sqlite.ts",
    "data:import-json": "tsx src/cli/storage/data.ts import-json",
    "data:export-json": "tsx src/cli/storage/data.ts export-json",
    "benchmark:lite": "tsx benchmarks/lite.ts",
    "eval:golden": "tsx evals/runners/golden.ts",
    "eval:suite": "tsx evals/runners/suite.ts",
    "eval:dense": "tsx evals/dense/run.ts",
    "eval:quality": "tsx evals/runners/quality.ts",
    "eval:baseline": "tsx evals/baseline/run.ts",
    "eval:candidates": "tsx evals/candidates/run.ts",
    "eval:ranking": "tsx evals/ranking/run.ts",
    "eval:facts": "tsx evals/facts/run.ts",
    "eval:context": "tsx evals/context/run.ts",
    "eval:answer": "tsx evals/answer/run.ts",
    "eval:reliability": "tsx evals/reliability/run.ts",
    "eval:reliability:faults": "tsx evals/reliability/faults.ts",
    "eval:diagnostics": "tsx evals/diagnostics/run.ts",
    "eval:lexical": "tsx evals/lexical/run.ts",
    "test:reliability": "vitest run test/core/runtime/read-runtime.test.ts test/reliability/reliability-sqlite.test.ts test/reliability/reliability-evaluation.test.ts test/storage/sqlite-maintenance.test.ts test/storage/storage-failure.test.ts",
    "test:reliability:soak": "OPEN_CONTINUITY_RELIABILITY_CYCLES=1000 vitest run test/reliability/reliability-soak.test.ts",
    "test": "vitest run",
    "pretest:core": "npm run build",
    "test:core": "tsx scripts/test-core-modules.ts",
    "test:core:list": "tsx scripts/test-core-modules.ts --list",
    "test:storage": "vitest run test/storage/storage-core-v1.test.ts test/storage/storage-contract.test.ts test/storage/storage-failure.test.ts test/storage/storage-postgres-real.test.ts test/storage/sqlite-store.test.ts test/storage/file-store.test.ts",
    "test:storage:postgres:docker": "node scripts/storage-postgres-fixture.mjs",
    "test:soak": "OPEN_CONTINUITY_SOAK_CYCLES=1000 vitest run test/capture-resilience.test.ts",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:architecture": "tsx scripts/check-core-boundaries.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fastify": "^5.12.6",
    "pg": "^8.23.1",
    "zod": "^4.6.6"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "pg-mem": "^2.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
